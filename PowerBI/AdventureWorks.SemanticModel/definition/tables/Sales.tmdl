/// One row per sales order line, for both the Internet and Reseller channels.
table Sales
	lineageTag: 1f1c1560-9d64-5a61-832e-3aab0ac20324
	sourceLineageTag: [gold].[FactSales]

	/// Total sales across both channels.
	measure 'Sales Amount' = SUM ( Sales[SalesAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		lineageTag: 6ee5f85e-68f2-5e85-9255-d949742dbf7c

	/// Sales made directly to customers online.
	measure 'Internet Sales' = CALCULATE ( [Sales Amount], Sales[Channel] = "Internet" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		lineageTag: dab16519-90c7-5455-a133-fe2c93fcc9db

	/// Sales made through resellers.
	measure 'Reseller Sales' = CALCULATE ( [Sales Amount], Sales[Channel] = "Reseller" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		lineageTag: 05f15178-a9d6-5d2e-8737-290bb7e5a43a

	/// Units sold.
	measure 'Order Quantity' = SUM ( Sales[OrderQuantity] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 140ccebd-0f1a-528f-8600-44252aa1560f

	/// Number of sales orders.
	measure Orders = DISTINCTCOUNT ( Sales[SalesOrderNumber] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: c115d238-fd1a-55fa-952a-4ef21c3afa2c

	/// Sales amount per order.
	measure 'Average Order Value' = DIVIDE ( [Sales Amount], [Orders] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		lineageTag: afe66d5d-5ed2-55db-88f3-fd15a73a613c

	/// Internet customers who bought something.
	measure Customers = DISTINCTCOUNTNOBLANK ( Sales[CustomerKey] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: cfa48ecb-a15f-5f66-bf6d-e778d33d49ca

	/// Standard cost of the products sold.
	measure 'Total Cost' = SUM ( Sales[TotalProductCost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Profitability
		lineageTag: 38ae1f6e-aebe-5418-9b2c-ffc6b734b961

	/// Sales amount less product cost.
	measure 'Gross Margin' = [Sales Amount] - [Total Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Profitability
		lineageTag: f76be4d1-84b0-5c36-a5ff-bbc21938f4b4

	/// Gross margin as a share of sales.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Sales Amount] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Profitability
		lineageTag: 5babc05f-de73-5f36-9379-c9c500bfc1a4

	/// Sales from January 1 to the last date in context.
	measure 'Sales YTD' = TOTALYTD ( [Sales Amount], 'Date'[Date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: 8ce4dfe1-05e6-596f-aab0-fa554280e033

	/// Sales in the same period one year earlier.
	measure 'Sales PY' = CALCULATE ( [Sales Amount], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: 503bba0f-bc1f-5e85-8b89-87c3ae772e4b

	/// Growth in sales against the same period one year earlier.
	measure 'Sales YoY %' = VAR PriorYear = [Sales PY] RETURN DIVIDE ( [Sales Amount] - PriorYear, PriorYear )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: d58ca297-d82a-562d-931e-08084e58eaee

	/// Sales placed on the date they shipped instead of the date they were ordered.
	measure 'Sales by Ship Date' = CALCULATE ( [Sales Amount], USERELATIONSHIP ( Sales[Ship Date], 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time intelligence
		lineageTag: 7a38fee1-6759-5b14-9ec3-e4c299f699cb

